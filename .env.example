# Server-side only. Without any provider credentials the app runs on the on-device engine.

# Which service runs Claude: "anthropic" (default, needs ANTHROPIC_API_KEY)
# or "bedrock" (Amazon Bedrock, Australian profile; uses your AWS login / IAM role).
MEDILOG_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AWS_PROFILE=medilog

# Shared token the app must send as x-medilog-token. Required on Lambda.
# MEDILOG_ACCESS_TOKEN=

# Optional overrides
# MEDILOG_EXTRACT_MODEL=claude-haiku-5-5        # bedrock default: au.anthropic.claude-haiku-5-5
# MEDILOG_REPORT_MODEL=claude-sonnet-5-5        # bedrock default: au.anthropic.claude-sonnet-5-5
# MEDILOG_AI=off
# MEDILOG_TRUST_PROXY=1                         # behind a proxy/load balancer
# PORT=8787
